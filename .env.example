# ── Coordinator wallet ───────────────────────────────────────────────
# Self-managed EVM private key for the coordinator. This wallet holds the
# Gateway unified USDC balance it pays workers out of. NEVER commit this.
EVM_PRIVATE_KEY=0xyour_coordinator_private_key

# ── Gateway routing ──────────────────────────────────────────────────
# Source chain the coordinator burns USDC from (must hold a Gateway deposit).
# Arc Testnet is the default: USDC is Arc's native gas token, so one faucet
# claim covers both funds and fees. See https://faucet.circle.com
GATEWAY_SOURCE_CHAIN=arc

# Destination chain workers get paid on (must match each worker's WALLET_ADDRESS chain).
GATEWAY_DEST_CHAIN=base

# ── Coordinator server ───────────────────────────────────────────────
PORT=4000

# ── Worker wallets ───────────────────────────────────────────────────
# Each worker process needs its own payout address (does not need a private
# key — it only receives USDC). Set per worker when you launch it, e.g.:
#   WORKER_WALLET_ADDRESS=0x... npm run worker:extract
WORKER_WALLET_ADDRESS=0xyour_worker_payout_address
